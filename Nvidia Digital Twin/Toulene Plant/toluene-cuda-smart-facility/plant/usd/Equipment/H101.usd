#usda 1.0
(
    defaultPrim = "H101"
)

def Xform "H101" (
    assetInfo = {
        string equipmentTag = "H101"
        string equipmentType = "heater_furnace"
        string cudaTile = "CUDA_TILE_H101"
        string glbViewer = "../glb/H101.glb"
    }
)
{
    def Mesh "HeaterShell" {}
    def Scope "Sensors" {
        def Attribute "temperature" ( customData = { string sensorTag = "TT102" } )
        def Attribute "duty" ( customData = { string sensorTag = "DT101" } )
    }
}
