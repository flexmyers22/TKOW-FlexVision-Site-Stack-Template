#usda 1.0
(
    defaultPrim = "R101"
)

def Xform "R101" (
    assetInfo = {
        string equipmentTag = "R101"
        string equipmentType = "plug_flow_reactor"
        string cudaTile = "CUDA_TILE_R101"
        string glbViewer = "../glb/R101.glb"
    }
)
{
    def Mesh "ReactorShell" {}
    def Scope "Sensors" {
        def Attribute "temperature" ( customData = { string sensorTag = "TT103" } )
        def Attribute "pressure" ( customData = { string sensorTag = "PT102" } )
    }
}
