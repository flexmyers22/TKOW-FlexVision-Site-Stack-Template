#usda 1.0
(
    defaultPrim = "P101"
)

def Xform "P101" (
    assetInfo = {
        string equipmentTag = "P101"
        string equipmentType = "centrifugal_pump"
        string cudaTile = "CUDA_TILE_P101"
        string glbViewer = "../glb/P101.glb"
    }
)
{
    def Mesh "PumpCasing" {}
    def Scope "Sensors" {
        def Attribute "flow" ( customData = { string sensorTag = "FT101" } )
        def Attribute "pressure" ( customData = { string sensorTag = "PT101" } )
    }
}
