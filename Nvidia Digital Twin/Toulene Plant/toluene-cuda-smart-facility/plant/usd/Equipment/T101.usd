#usda 1.0
(
    defaultPrim = "T101"
)

def Xform "T101" (
    assetInfo = {
        string equipmentTag = "T101"
        string equipmentType = "toluene_tank"
        string cudaTile = "CUDA_TILE_T101"
        string glbViewer = "../glb/T101.glb"
    }
)
{
    def Mesh "TankShell" {}
    def Scope "Sensors" {
        def Attribute "level" ( customData = { string sensorTag = "LT101" } )
        def Attribute "temperature" ( customData = { string sensorTag = "TT101" } )
    }
}
